{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "legaleasier.org" }
      ],
      "destination": "https://www.legaleasier.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "http://legaleasier.org" }
      ],
      "destination": "https://www.legaleasier.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Bingbot|Yahoo|DuckDuckBot|YandexBot|baiduspider).*"
        }
      ],
      "destination": "https://service.prerender.io/https://www.legaleasier.org/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
